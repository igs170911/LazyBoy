#!/usr/bin/python3
"""Records what the human does in desktop apps (not Chromium) while teaching the bot.

X RECORD sees every click and key, whether it came over VNC or XTEST; AT-SPI
names what was clicked. Chromium is skipped: box-teach-browser records it with
page semantics. Usage: box-teach-desktop <lesson dir>. Writes desktop.jsonl and
shots/d-*.jpg; `.paused` drops events, `.stop` ends it and writes `.done-desktop`.
"""
import json
import os
import queue
import subprocess
import sys
import threading
import time
import warnings

from Xlib import X, XK, display
from Xlib.ext import record
from Xlib.protocol import rq

warnings.filterwarnings("ignore", category=DeprecationWarning)
os.environ.setdefault("DISPLAY", ":1")
try:
    with open("/tmp/lazyboy/dbus.env", encoding="utf-8") as fh:
        for line in fh:
            key, _, value = line.strip().partition("=")
            if key == "DBUS_SESSION_BUS_ADDRESS" and value: os.environ.setdefault(key, value)
except OSError: pass

DIR = sys.argv[1]
os.makedirs(os.path.join(DIR, "shots"), exist_ok=True)
events = queue.Queue()
ROLE_SHORT = {"push button": "button", "toggle button": "toggle", "radio button": "radio", "check box": "checkbox",
              "menu item": "menuitem", "page tab": "tab", "combo box": "combobox", "entry": "textbox",
              "password text": "password", "list item": "listitem", "tree item": "treeitem", "table cell": "cell"}
SPECIAL = {"Return": "Enter", "KP_Enter": "Enter", "Tab": "Tab", "Escape": "Escape", "Delete": "Delete",
           "Up": "Up", "Down": "Down", "Left": "Left", "Right": "Right", "Page_Up": "PageUp", "Page_Down": "PageDown",
           "Home": "Home", "End": "End", **{f"F{i}": f"F{i}" for i in range(1, 13)}}
MODIFIERS = {"Shift_L", "Shift_R", "Control_L", "Control_R", "Alt_L", "Alt_R", "Super_L", "Super_R", "Meta_L", "Meta_R",
             "ISO_Level3_Shift", "Caps_Lock", "Num_Lock"}


def paused(): return os.path.exists(os.path.join(DIR, ".paused"))


def listen():
    """Blocks in X RECORD on its own connection; hands raw events to the main thread."""
    source = display.Display()
    context = source.record_create_context(0, [record.AllClients], [{
        "core_requests": (0, 0), "core_replies": (0, 0), "ext_requests": (0, 0, 0, 0), "ext_replies": (0, 0, 0, 0),
        "delivered_events": (0, 0), "device_events": (X.KeyPress, X.ButtonPress), "errors": (0, 0),
        "client_started": False, "client_died": False}])
    def handle(reply):
        if reply.category != record.FromServer or reply.client_swapped: return
        data = reply.data
        while data:
            event, data = rq.EventField(None).parse_binary_value(data, source.display, None, None)
            events.put((time.time(), event.type, event.detail, event.state, event.root_x, event.root_y))
    source.record_enable_context(context, handle)


NAMES = {getattr(XK, n): n[3:] for n in dir(XK) if n.startswith("XK_")}


def window(d):
    """Title and class of the focused top-level window."""
    try:
        wid = subprocess.run(["xdotool", "getactivewindow"], capture_output=True, text=True, timeout=2).stdout.strip()
        if not wid: return "", ""
        title = subprocess.run(["xdotool", "getwindowname", wid], capture_output=True, text=True, timeout=2).stdout.strip()
        klass = subprocess.run(["xprop", "-id", wid, "WM_CLASS"], capture_output=True, text=True, timeout=2).stdout
        return title, klass.rpartition(",")[2].strip().strip('"')
    except (OSError, subprocess.TimeoutExpired): return "", ""


def browser(klass): return "chrom" in klass.lower()


Atspi = None
def element_at(x, y):
    """Deepest accessible under the point, with its role and name."""
    global Atspi
    try:
        if Atspi is None:
            import gi
            gi.require_version("Atspi", "2.0")
            from gi.repository import Atspi as module
            Atspi = module; Atspi.init()
        desktop = Atspi.get_desktop(0)
        best = None
        for i in range(desktop.get_child_count()):
            app = desktop.get_child_at_index(i)
            if app is None or (app.get_name() or "") in {"xfdesktop", "box-a11y"}: continue
            for j in range(app.get_child_count()):
                node = app.get_child_at_index(j)
                if node is None: continue
                try:
                    if not node.get_state_set().contains(Atspi.StateType.SHOWING): continue
                    for _ in range(40):
                        child = node.get_accessible_at_point(x, y, Atspi.CoordType.SCREEN)
                        if child is None: break
                        node = child
                    if node.get_index_in_parent() >= 0 or best is None: best = node
                except Exception: continue
        if best is None: return None
        role = best.get_role_name()
        rect = best.get_extents(Atspi.CoordType.SCREEN)
        return {"role": ROLE_SHORT.get(role, role.replace(" ", "")), "name": (best.get_name() or "").strip()[:80],
                "box": [rect.x, rect.y, rect.width, rect.height]}
    except Exception:
        return None


count = 0
def shot():
    global count
    count += 1
    name = f"shots/d-{count:04d}.jpg"
    try:
        subprocess.run(["import", "-silent", "-window", "root", "-quality", "60", os.path.join(DIR, name)], timeout=5, check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return name
    except (OSError, subprocess.SubprocessError): return None


def write(row):
    with open(os.path.join(DIR, "desktop.jsonl"), "a", encoding="utf-8") as fh: fh.write(json.dumps(row, ensure_ascii=False) + "\n")


def main():
    d = display.Display()
    screen = d.screen()
    threading.Thread(target=listen, daemon=True).start()
    typed = {"text": "", "at": 0, "window": "", "target": None}
    last_target = None
    secret = False

    def flush():
        if typed["text"]:
            write({"at": typed["at"], "source": "desktop", "kind": "input", "window": typed["window"], "target": typed["target"],
                   "value": "••••" if secret else typed["text"][:500], "secret": secret, "shot": shot()})
        typed.update(text="", at=0)

    open(os.path.join(DIR, ".ready-desktop"), "w").write(str(os.getpid()))
    # RECORD's device events carry no reliable modifier state; track it from presses and releases.
    held = set()
    while not os.path.exists(os.path.join(DIR, ".stop")):
        try: at, kind, detail, state, x, y = events.get(timeout=.3)
        except queue.Empty:
            continue
        if kind in (X.KeyPress, X.KeyRelease):
            name = NAMES.get(d.keycode_to_keysym(detail, 0), "")
            if name in MODIFIERS:
                (held.add if kind == X.KeyPress else held.discard)(name.split("_")[0])
                continue
            if kind == X.KeyRelease: continue
        if paused(): typed.update(text=""); continue
        if kind == X.ButtonPress:
            if detail not in (1, 3): continue
            flush()
            title, klass = window(d)
            if browser(klass): last_target = None; continue
            target = element_at(x, y)
            secret = bool(target and target["role"] == "password")
            last_target = target
            write({"at": int(at * 1000), "source": "desktop", "kind": "click" if detail == 1 else "right_click", "window": title, "app": klass,
                   "target": target, "point": [x, y], "screen": [screen.width_in_pixels, screen.height_in_pixels], "shot": shot()})
            continue
        shift, control = "Shift" in held, bool(held & {"Control", "Alt", "Super", "Meta"})
        keysym = d.keycode_to_keysym(detail, 1 if shift else 0) or d.keycode_to_keysym(detail, 0)
        name = NAMES.get(keysym, "")
        char = chr(keysym) if 0x20 <= keysym <= 0x7e or 0xa0 <= keysym <= 0xff else chr(keysym & 0xffffff) if keysym & 0xff000000 == 0x01000000 else ""
        if char and not control:
            if not typed["text"]:
                title, klass = window(d)
                if browser(klass) or klass in {"xfdesktop", ""}: continue
                typed.update(at=int(at * 1000), window=title, target=last_target)
            typed["text"] += char
        elif name == "BackSpace" and not control:
            typed["text"] = typed["text"][:-1]
        elif control or name in SPECIAL:
            title, klass = window(d)
            if browser(klass): continue
            flush()
            label = "".join(m + "+" for m in ("Ctrl", "Alt", "Super") if {"Ctrl": "Control"}.get(m, m) in held) + ("Shift+" if shift and control else "")
            label += SPECIAL.get(name) or (name.upper() if len(name) == 1 else name)
            write({"at": int(at * 1000), "source": "desktop", "kind": "key", "key": label, "window": title, "app": klass, "shot": shot()})
    flush()
    open(os.path.join(DIR, ".done-desktop"), "w").close()
    os._exit(0)


if __name__ == "__main__": main()
